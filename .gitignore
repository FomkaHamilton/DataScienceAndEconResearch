# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# --- Environments ---
.venv/
venv/
env/
.env

# --- Data (raw data is documented via manifests, not committed by default) ---
projects/**/data/raw/*
!projects/**/data/raw/.gitkeep

# Processed data is excluded by default, but small, public, unrestricted
# derived datasets may be committed explicitly (see each project's
# data/MANIFEST.md for provenance). Exceptions below.
projects/**/data/processed/*
!projects/**/data/processed/.gitkeep
!projects/p1-bfs-establishment-births/data/processed/bfs_state_applications.csv
!projects/p1-bfs-establishment-births/data/processed/bed_state_establishment_births_deaths.csv
!projects/p1-bfs-establishment-births/data/processed/bds_state_new_firm_share.csv
!projects/p1-bfs-establishment-births/data/processed/analysis_panel_quarterly.csv
!projects/p1-bfs-establishment-births/data/processed/forecast_dataset.csv

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
*.swp

# --- Outputs that are regenerated by code ---
# Excluded by default; small figures directly referenced by a findings
# doc may be committed explicitly so they render on GitHub.
projects/**/outputs/figures/*
!projects/**/outputs/figures/.gitkeep
!projects/p1-bfs-establishment-births/outputs/figures/national_bfs_vs_bed_yoy.png
!projects/p1-bfs-establishment-births/outputs/figures/state_examples_bfs_vs_bed_yoy.png
