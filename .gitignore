# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# --- Environments ---
.venv/
venv/
env/
.env

# --- Data (raw/processed data is documented via manifests, not committed by default) ---
projects/**/data/raw/*
!projects/**/data/raw/.gitkeep
projects/**/data/processed/*
!projects/**/data/processed/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
*.swp

# --- Outputs that are regenerated by code ---
projects/**/outputs/figures/*
!projects/**/outputs/figures/.gitkeep
